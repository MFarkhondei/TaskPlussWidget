<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_task_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_task_row"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layoutDirection="rtl"
    android:layout_marginBottom="4dp">

    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_check_empty"
        android:contentDescription="وضعیت" />

    <TextView
        android:id="@+id/tv_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text=""
        android:textSize="16sp"
        android:textColor="#F8FAFC"
        android:fontFamily="@font/vazirmatn_bold"
        android:maxLines="3"
        android:ellipsize="end"
        android:paddingStart="10dp"
        android:paddingEnd="6dp" />

    <TextView
        android:id="@+id/tv_task_priority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#F5C542"
        android:fontFamily="@font/vazirmatn_bold"
        android:minWidth="22dp"
        android:gravity="center"
        android:paddingStart="4dp" />
</LinearLayout>
