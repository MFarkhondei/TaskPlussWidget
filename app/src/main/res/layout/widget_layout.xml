<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/row_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iv_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:contentDescription="تسک پلاس" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <ImageView
                android:id="@+id/iv_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:paddingEnd="0dp"
                android:contentDescription="وضعیت" />

            <ImageView
                android:id="@+id/iv_refresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="رفرش"
                android:padding="1dp"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_add_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_add_btn"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_add"
            android:contentDescription="افزودن" />

        <ImageView
            android:id="@+id/iv_add_task_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingStart="8dp"
            android:contentDescription="افزودن تسک جدید" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btn_group_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="‹"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F5C542"
            android:gravity="center"
            android:background="@drawable/bg_chip" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:gravity="center">

            <ImageView
                android:id="@+id/chip_group_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="36dp"
                android:background="@drawable/bg_chip_selected"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="گروه" />

            <ImageView
                android:id="@+id/chip_group_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="36dp"
                android:background="@drawable/bg_chip"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone"
                android:contentDescription="گروه" />

            <ImageView
                android:id="@+id/chip_group_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="36dp"
                android:background="@drawable/bg_chip"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone"
                android:contentDescription="گروه" />

            <ImageView
                android:id="@+id/chip_group_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="36dp"
                android:background="@drawable/bg_chip"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:contentDescription="گروه" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_group_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="›"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F5C542"
            android:gravity="center"
            android:background="@drawable/bg_chip" />
    </LinearLayout>

    <ListView
        android:id="@+id/list_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

    <ImageView
        android:id="@+id/iv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:padding="16dp"
        android:visibility="gone"
        android:contentDescription="خالی" />

</LinearLayout>
