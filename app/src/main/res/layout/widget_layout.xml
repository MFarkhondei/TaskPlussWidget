<?xml version="1.0" encoding="utf-8"?>
<!-- LinearLayout + TextView + ImageView + ListView (اسکرول عمودی مجاز) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تسک پلاس"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F5C542"
            android:fontFamily="@font/vazirmatn"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/tv_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:fontFamily="@font/vazirmatn"
            android:paddingEnd="8dp"
            android:paddingStart="4dp" />

        <ImageView
            android:id="@+id/iv_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="رفرش"
            android:padding="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_add_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_add_btn"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_add"
            android:contentDescription="افزودن" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="افزودن تسک جدید"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0A0F1A"
            android:fontFamily="@font/vazirmatn"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- گروه‌ها: دکمه‌های ‹ › برای دیدن همه گروه‌ها (HorizontalScrollView در RemoteViews نیست) -->
    <LinearLayout
        android:id="@+id/row_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_group_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="‹"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F5C542"
            android:gravity="center"
            android:background="@drawable/bg_chip" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:gravity="center">

            <TextView
                android:id="@+id/chip_group_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="همه"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F5C542"
                android:fontFamily="@font/vazirmatn"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="3dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/chip_group_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:fontFamily="@font/vazirmatn"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_group_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:fontFamily="@font/vazirmatn"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_group_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:fontFamily="@font/vazirmatn"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_group_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="›"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F5C542"
            android:gravity="center"
            android:background="@drawable/bg_chip" />
    </LinearLayout>

    <ListView
        android:id="@+id/list_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تسکی وجود ندارد"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

</LinearLayout>
