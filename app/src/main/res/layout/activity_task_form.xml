<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1A"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عنوان"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="@font/vazirmatn"
            android:paddingBottom="2dp" />

        <EditText
            android:id="@+id/et_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان تسک…"
            android:minLines="1"
            android:maxLines="2"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:fontFamily="@font/vazirmatn"
            android:background="@drawable/bg_section"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اولویت"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:fontFamily="@font/vazirmatn"
                    android:paddingBottom="2dp" />

                <Spinner
                    android:id="@+id/spinner_priority"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_section"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="گروه"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:fontFamily="@font/vazirmatn"
                    android:paddingBottom="2dp" />

                <Spinner
                    android:id="@+id/spinner_group"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_section"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وضعیت"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="@font/vazirmatn"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_status_todo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="انجام‌نشده"
                android:textSize="12.5sp"
                android:textColor="#F5C542"
                android:textStyle="bold"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_chip_selected" />

            <TextView
                android:id="@+id/tv_status_doing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="در حال انجام"
                android:textSize="12.5sp"
                android:textColor="#94A3B8"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_chip" />

            <TextView
                android:id="@+id/tv_status_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="انجام‌شده"
                android:textSize="12.5sp"
                android:textColor="#94A3B8"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_chip" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تاریخ انجام (شمسی)"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="@font/vazirmatn"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_due_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="بدون تاریخ"
                android:textSize="13sp"
                android:textColor="#F8FAFC"
                android:fontFamily="@font/vazirmatn"
                android:background="@drawable/bg_section"
                android:padding="10dp" />

            <Button
                android:id="@+id/btn_pick_date"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="امروز"
                android:textSize="12sp"
                android:textColor="#0A0F1A"
                android:fontFamily="@font/vazirmatn"
                android:backgroundTint="#F5C542"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_clear_date"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="پاک"
                android:textSize="12sp"
                android:textColor="#F8FAFC"
                android:fontFamily="@font/vazirmatn"
                android:backgroundTint="#1A2438"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="یادداشت (اختیاری)"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="@font/vazirmatn"
            android:paddingBottom="2dp" />

        <EditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="یادداشت…"
            android:minLines="2"
            android:maxLines="3"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:fontFamily="@font/vazirmatn"
            android:background="@drawable/bg_section"
            android:padding="10dp"
            android:layout_marginBottom="10dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save_task"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="ذخیره تسک"
            android:textColor="#0A0F1A"
            android:textSize="14sp"
            android:fontFamily="@font/vazirmatn"
            android:backgroundTint="#F5C542"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_delete_task"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="حذف تسک"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn"
            android:backgroundTint="#B91C1C"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="بستن"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:fontFamily="@font/vazirmatn"
            android:backgroundTint="#1A2438"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_add_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:fontFamily="@font/vazirmatn" />
    </LinearLayout>
</ScrollView>
