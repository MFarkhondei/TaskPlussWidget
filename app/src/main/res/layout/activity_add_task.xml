<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1A"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="افزودن تسک جدید"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#F5C542"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="عنوان تسک"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/et_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="عنوان تسک را بنویسید…"
        android:minLines="2"
        android:maxLines="4"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:background="@drawable/bg_section"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_save_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ذخیره تسک"
        android:textColor="#0A0F1A"
        android:backgroundTint="#F5C542" />

    <TextView
        android:id="@+id/tv_add_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:paddingTop="12dp"
        android:gravity="center" />

</LinearLayout>
